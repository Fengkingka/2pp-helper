{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib", "data", "tests", "types", "browser.ts", "hk.ts"],
  "exclude": ["node_modules"]
}
