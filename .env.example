# 複製成 .env（放在 repo 根目錄，即 site/ 的上一層，不會被公開）
# 沒有設定 API key 時，網站自動使用「示範模式」：流程完整，但評分和 AI 回覆由簡單規則產生。

# live = 呼叫 AI；mock = 示範模式。留空則按有沒有 API key 自動決定。
LLM_MODE=

# 任何 OpenAI 相容的 /chat/completions 端點（按比賽地區可用的供應商填寫）
LLM_BASE_URL=https://[供應商網址]/v1
LLM_API_KEY=
LLM_MODEL_CHAT=[對話用模型名稱]
LLM_MODEL_EVAL=[評分用模型名稱]

# 供應商支援 response_format: json_object 時設為 true，評分更穩定
LLM_JSON_MODE=false
LLM_TIMEOUT=45

# 每個 IP 每小時的上限，避免費用失控
RATE_LIMIT_EVAL_PER_HOUR=30
RATE_LIMIT_CHAT_PER_HOUR=120

# Relative to the project root; TLS verification remains enabled.
LLM_CA_FILE=

# Optional MiniMax speech; a blank key keeps browser speech.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_ASR_MODEL=asr-1.0
MINIMAX_VOICE_EN=English_expressive_narrator
MINIMAX_VOICE_YUE=Cantonese_GentleLady
RATE_LIMIT_SPEECH_PER_HOUR=120

# FitCheck reuses LLM_BASE_URL / LLM_API_KEY / LLM_MODEL_CHAT.
# Optional market-data connectors. Leave blank for manual evidence only.
# Google Trends AND competitor search are provided THROUGH SerpApi
# (google_trends + google engines), not the gated Google alpha API.
# One SerpApi key enables both sources.
FITCHECK_SERPAPI_KEY=
# Community discussions use the Hacker News Algolia search API:
# free, no key, no registration, no OAuth required.
RATE_LIMIT_FITCHECK_PER_HOUR=20
