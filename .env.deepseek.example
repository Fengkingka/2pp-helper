# For a merged site, keep the team's existing settings and append only ADVISOR_* settings.
# For a standalone site, copy to .env and configure the relevant keys locally.
# Do not include .env in shared archives or put a key in browser JavaScript.
LLM_MODE=live
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_CHAT=deepseek-flash
LLM_MODEL_EVAL=deepseek-v4-pro
LLM_JSON_MODE=true
LLM_TIMEOUT=60
LLM_CA_FILE=certs/cacert.pem
RATE_LIMIT_CHAT_PER_HOUR=120
RATE_LIMIT_EVAL_PER_HOUR=30

# Only Career Direction chat and its path suggestions use this key.
# On failure, try the team's LLM_API_KEY next, then use the rule fallback.
ADVISOR_LLM_MODE=live
ADVISOR_LLM_BASE_URL=https://api.deepseek.com
ADVISOR_LLM_API_KEY=
ADVISOR_LLM_MODEL=deepseek-flash
RATE_LIMIT_ADVISOR_PER_HOUR=120
